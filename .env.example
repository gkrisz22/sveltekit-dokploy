# SvelteKit runtime — adapter-node reads PORT/HOST
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Behind Traefik (TLS terminated upstream), adapter-node must be told to trust
# the forwarded headers nginx passes through. Without these, url.origin is
# http:// while the browser sends an https:// Origin, and SvelteKit rejects
# every POST form action as a cross-site submission. See README → Env.
# Single-domain alternative: ORIGIN=https://demo.example.com
PROTOCOL_HEADER=x-forwarded-proto
HOST_HEADER=x-forwarded-host
ADDRESS_HEADER=x-forwarded-for
# Hops prepending to X-Forwarded-For before the app: Traefik, then nginx.
XFF_DEPTH=2

# Build metadata — injected by Dockerfile ARGs / GitHub Actions
# Shown on the demo page via /api/info
GIT_COMMIT_SHA=local
GIT_BRANCH=local
BUILD_TIME=2025-01-01T00:00:00Z

# Local compose overrides (optional)
HOST_PORT=8080
IMAGE_NAME=ghcr.io/gkrisz22/sveltekit-dokploy:local

# GHCR image used by Dokploy prod compose (docker-compose.yml)
# Already set in docker-compose.yml: `image: ghcr.io/gkrisz22/sveltekit-dokploy:latest`
# CI pushes ghcr.io/<github.repository>:latest and :<sha>

# Dokploy / GitHub Actions secrets (NOT for local .env — set in GitHub repo settings)
# DOKPLOY_URL=https://dokploy.example.com
# DOKPLOY_TOKEN=dokploy_xxx...
# DOKPLOY_COMPOSE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx  # Compose service ID (not Application)
# GITHUB_TOKEN is auto-provided for GHCR push (packages: write)
